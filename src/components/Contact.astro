---
import cube from '../assets/cube.svg';
import background from '../assets/background.svg';
import Card from './Card.astro';
import CardGrid from './CardGrid.astro';
---

<div id="container">
    <img id="background" src={background.src} alt="" fetchpriority="high" />
    <main>
        <section id="hero">

            <h1>
                Contact
            </h1>
			<p>Feel free to reach out to me!</p>
            <CardGrid>
                <Card title="Email" content="No Spam Email Please" link="mailto:contact@joshattic.us" linkTitle="Send Email" />
                <Card title="Discord" content="Discord Server" link="https://discord.gg/havaGJytvH" linkTitle="Join" />
                <Card title="Blog" content="My awesome little technology blog" link="https://blog.joshattic.us" linkTitle="Visit" />
            </CardGrid>

            <h1>
                Socials
            </h1>
            <p>Find me on social media</p>
            <CardGrid>
                <Card title="TikTok" link="https://www.tiktok.com/@joshatticus" linkTitle="Visit" shape="square" buttonStyle="full" avatarSrc="/avatars/tiktok.png"/>
                <Card title="GitHub" link="https://github.com/JoshAtticus" linkTitle="Visit" shape="square" buttonStyle="full" avatarSrc="/avatars/github.png"/>
                <Card title="YouTube" link="https://youtube.com/@joshatticus" linkTitle="Visit" shape="square" buttonStyle="full" avatarSrc="/avatars/youtube.png"/>
                <Card title="Twitter" link="https://twitter.com/joshatticus" linkTitle="Visit" shape="square" buttonStyle="full" avatarSrc="/avatars/twitter.jpg"/>
                <Card title="wasteof.money" link="https://wasteof.money/users/joshatticus" linkTitle="Visit" shape="square" buttonStyle="full" avatarSrc="/avatars/wasteof.png"/>
            </CardGrid>
        </section>
    </main>
</div>

<style>
    #background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        filter: blur(100px);
		background-color: #000000
    }

    #container {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        min-height: 100vh;
        background-color: #0f0f0f;
        color: #e5e7eb;
        overflow-y: auto;
    }

    main {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        z-index: 1;
        padding-top: 100px;
        padding-bottom: 60px;
    }

    #hero {
        display: flex;
        align-items: center;
        flex-direction: column;
        padding: 16px;
        z-index: 1;
        width: 100%;
        max-width: 1200px;
    }

    h1 {
        font-size: 22px;
        margin-top: 0.25em;
        color: #f9fafb;
    }

    #links {
        display: flex;
        gap: 16px;
    }

    #links a {
        display: flex;
        align-items: center;
        padding: 10px 12px;
        color: #d1d5db;
        text-decoration: none;
        transition: color 0.2s;
    }

    #links a:hover {
        color: #f3f4f6;
    }

    #links a svg {
        height: 1em;
        margin-left: 8px;
    }

    #links a.button {
        color: white;
        background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
        box-shadow:
            inset 0 0 0 1px rgba(255, 255, 255, 0.12),
            inset 0 -2px 0 rgba(0, 0, 0, 0.24);
        border-radius: 10px;
    }

    #links a.button:hover {
        color: rgb(230, 230, 230);
        box-shadow: none;
    }

    pre {
        font-family:
            ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
            monospace;
        font-weight: normal;
        background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0;
    }

    h2 {
        margin: 0 0 1em;
        font-weight: normal;
        color: #f9fafb;
        font-size: 20px;
    }

    p {
        color: #9ca3af;
        font-size: 16px;
        line-height: 24px;
        letter-spacing: -0.006em;
        margin: 0;
    }

    code {
        display: inline-block;
        background:
            linear-gradient(66.77deg, #2d1b2e 0%, #3d1f3e 100%) padding-box,
            linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
        border-radius: 8px;
        border: 1px solid transparent;
        padding: 6px 8px;
        color: #e5e7eb;
    }

    .box {
        padding: 16px;
        background: rgba(17, 24, 39, 0.8);
        border-radius: 16px;
        border: 1px solid #374151;
        backdrop-filter: blur(10px);
    }

    #news {
        position: absolute;
        bottom: 16px;
        right: 16px;
        max-width: 300px;
        text-decoration: none;
        transition: background 0.2s;
        backdrop-filter: blur(50px);
        background: rgba(17, 24, 39, 0.3);
    }

    #news:hover {
        background: rgba(17, 24, 39, 0.6);
    }

    @media screen and (max-height: 368px) {
        #news {
            display: none;
        }
    }

    @media screen and (max-width: 768px) {
        #container {
            display: flex;
            flex-direction: column;
        }

        #hero {
            display: block;
            padding-top: 10%;
        }

        #links {
            flex-wrap: wrap;
        }

        #links a.button {
            padding: 14px 18px;
        }

        #news {
            right: 16px;
            left: 16px;
            bottom: 2.5rem;
            max-width: 100%;
        }

        h1 {
            line-height: 1.5;
        }
    }
</style>