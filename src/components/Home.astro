---
import cube from '../assets/cube.svg';
import background from '../assets/background.svg';
---

<div id="container">
    <main>
        <img id="background" src={background.src} alt="" fetchpriority="high" />
        <section id="hero">
            <img src={cube.src} width="48" height="48" alt="JoshAtticus Logo" />
            <br>
            <h1>
                Hey! 👋 I'm JoshAtticus
            </h1>
			<p>I exist probably somewhere on the internet.</p>
            <!-- <section id="links">
                <a class="button" href="https://docs.astro.build">View my projects</a>
            </section>   -->
        </section>
        
        <!-- Scroll down indicator - Not in Use
        <div id="scroll-indicator">
            <div class="scroll-arrow">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <span>Scroll down</span>
        </div> -->
    </main>
</div>

<style>
    #background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        filter: blur(100px);
		background-color: #000000
    }

    #container {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        height: 100%;
        background-color: #0f0f0f;
        color: #e5e7eb;
    }

    main {
        height: 100%;
        display: flex;
        justify-content: center;
        z-index: 1;
    }

    #hero {
        display: flex;
        align-items: start;
        flex-direction: column;
        justify-content: center;
        padding: 16px;
        z-index: 1;

    }

    h1 {
        font-size: 22px;
        margin-top: 0.25em;
        color: #f9fafb;
    }

    #links {
        display: flex;
        gap: 16px;
    }

    #links a {
        display: flex;
        align-items: center;
        padding: 10px 12px;
        color: #d1d5db;
        text-decoration: none;
        transition: color 0.2s;
    }

    #links a:hover {
        color: #f3f4f6;
    }

    #links a svg {
        height: 1em;
        margin-left: 8px;
    }

    #links a.button {
        color: white;
        background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
        box-shadow:
            inset 0 0 0 1px rgba(255, 255, 255, 0.12),
            inset 0 -2px 0 rgba(0, 0, 0, 0.24);
        border-radius: 10px;
    }

    #links a.button:hover {
        color: rgb(230, 230, 230);
        box-shadow: none;
    }

    #scroll-indicator {
        position: absolute;
        bottom: 32px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        color: #9ca3af;
        z-index: 2;
        cursor: pointer;
        transition: color 0.2s;
    }

    #scroll-indicator:hover {
        color: #d1d5db;
    }

    #scroll-indicator span {
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.5px;
    }

    .scroll-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border: 1px solid rgba(156, 163, 175, 0.3);
        border-radius: 50%;
        backdrop-filter: blur(10px);
        background: rgba(17, 24, 39, 0.2);
    }

    pre {
        font-family:
            ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
            monospace;
        font-weight: normal;
        background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0;
    }

    h2 {
        margin: 0 0 1em;
        font-weight: normal;
        color: #f9fafb;
        font-size: 20px;
    }

    p {
        color: #9ca3af;
        font-size: 16px;
        line-height: 24px;
        letter-spacing: -0.006em;
        margin: 0;
    }

    code {
        display: inline-block;
        background:
            linear-gradient(66.77deg, #2d1b2e 0%, #3d1f3e 100%) padding-box,
            linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
        border-radius: 8px;
        border: 1px solid transparent;
        padding: 6px 8px;
        color: #e5e7eb;
    }

    .box {
        padding: 16px;
        background: rgba(17, 24, 39, 0.8);
        border-radius: 16px;
        border: 1px solid #374151;
        backdrop-filter: blur(10px);
    }

    #news {
        position: absolute;
        bottom: 16px;
        right: 16px;
        max-width: 300px;
        text-decoration: none;
        transition: background 0.2s;
        backdrop-filter: blur(50px);
        background: rgba(17, 24, 39, 0.3);
    }

    #news:hover {
        background: rgba(17, 24, 39, 0.6);
    }

    @media screen and (max-height: 368px) {
        #news {
            display: none;
        }
    }

    @media screen and (max-width: 768px) {
        #container {
            display: flex;
            flex-direction: column;
        }

        #hero {
            display: block;
            padding-top: 10%;
        }

        #links {
            flex-wrap: wrap;
        }

        #links a.button {
            padding: 14px 18px;
        }

        #news {
            right: 16px;
            left: 16px;
            bottom: 2.5rem;
            max-width: 100%;
        }

        h1 {
            line-height: 1.5;
        }
    }

    /* Scroll down indicator styles */
    #scroll-indicator {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: absolute;
        bottom: 32px;
        left: 50%;
        transform: translateX(-50%);
        color: #d1d5db;
        font-size: 14px;
        z-index: 1;
    }
</style>