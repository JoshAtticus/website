---
import cube from '../assets/cube.svg';
import background from '../assets/background.svg';
import Card from './Card.astro';
import Button from './Button.astro';
---

<div id="container">
    <img id="background" src={background.src} alt="" fetchpriority="high" />
    <main>
        <section id="hero">

            <h1>
                Looking for your JoshAtticusID?
            </h1>
			<p>You can sign into JoshAtticusID by clicking the button below</p>
            <br>
            <section id="links">
                <Button href="https://id.joshattic.us" target="_blank">
                    Sign into JoshAtticusID
                </Button>
            </section>
        </section>
    </main>
</div>

<style>
    #background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        filter: blur(100px);
		background-color: #000000
    }

    #container {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        height: 100%;
        background-color: #0f0f0f;
        color: #e5e7eb;
    }

    main {
        height: 100%;
        display: flex;
        justify-content: center;
        z-index: 1;
    }

    #hero {
        display: flex;
        align-items: start;
        flex-direction: column;
        justify-content: center;
        padding: 16px;
        z-index: 1;
    }

    h1 {
        font-size: 22px;
        margin-top: 0.25em;
        color: #f9fafb;
    }

    #links {
        display: flex;
        gap: 16px;
    }

    pre {
        font-family:
            ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
            monospace;
        font-weight: normal;
        background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0;
    }

    h2 {
        margin: 0 0 1em;
        font-weight: normal;
        color: #f9fafb;
        font-size: 20px;
    }

    p {
        color: #9ca3af;
        font-size: 16px;
        line-height: 24px;
        letter-spacing: -0.006em;
        margin: 0;
    }

    code {
        display: inline-block;
        background:
            linear-gradient(66.77deg, #2d1b2e 0%, #3d1f3e 100%) padding-box,
            linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
        border-radius: 8px;
        border: 1px solid transparent;
        padding: 6px 8px;
        color: #e5e7eb;
    }

    .box {
        padding: 16px;
        background: rgba(17, 24, 39, 0.8);
        border-radius: 16px;
        border: 1px solid #374151;
        backdrop-filter: blur(10px);
    }

    #news {
        position: absolute;
        bottom: 16px;
        right: 16px;
        max-width: 300px;
        text-decoration: none;
        transition: background 0.2s;
        backdrop-filter: blur(50px);
        background: rgba(17, 24, 39, 0.3);
    }

    #news:hover {
        background: rgba(17, 24, 39, 0.6);
    }

    @media screen and (max-height: 368px) {
        #news {
            display: none;
        }
    }

    @media screen and (max-width: 768px) {
        #container {
            display: flex;
            flex-direction: column;
        }

        #hero {
            display: block;
            padding-top: 10%;
        }

        #links {
            flex-wrap: wrap;
        }

        #news {
            right: 16px;
            left: 16px;
            bottom: 2.5rem;
            max-width: 100%;
        }

        h1 {
            line-height: 1.5;
        }
    }
</style>