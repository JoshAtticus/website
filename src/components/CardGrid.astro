---
// component that displays a grid of cards.
--- 

<div class="card-grid">
    <slot />
</div>

<style>
    .card-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        padding: 2rem 0;
        width: 100%;
        max-width: 1200px;
        justify-content: center;
    }
    
    /* Limit square cards to 3 per row */
    .card-grid:has(.card-square) {
        max-width: 800px;
    }
    
    @media (max-width: 768px) {
        .card-grid {
            gap: 1rem;
            padding: 1.5rem 0;
        }
        
        .card-grid:has(.card-square) {
            max-width: 100%;
        }
    }
</style>
